APP_NAME=DQPS-Engine
APP_ENV=development
LOG_LEVEL=INFO

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_TABLE_EVENTS=engine_events
SUPABASE_TABLE_RECOMMENDATIONS=recommendations
SUPABASE_TABLE_EXECUTIONS=executions
SUPABASE_TABLE_FEEDBACK=outcome_feedback

LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key
LLM_MODEL=gemini-1.5-flash

NN_LIBRARY_PATH=./native/libnn.so

META_API_BASE=https://graph.facebook.com/v19.0
META_ACCESS_TOKEN=mock-meta-token
GOOGLE_ADS_API_BASE=https://googleads.googleapis.com/v16
GOOGLE_ADS_TOKEN=mock-google-token

INGEST_INTERVAL_MINUTES=5
DIAGNOSE_INTERVAL_MINUTES=10
