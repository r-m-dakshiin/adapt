APP_NAME=ADAPT-Engine
APP_ENV=development
LOG_LEVEL=INFO

OPENROUTER_API_KEY=your-openrouter-key
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=ADAPT-Engine

NN_LIBRARY_PATH=./native/libnn.so

META_API_BASE=https://graph.facebook.com/v19.0
META_ACCESS_TOKEN=your-meta-token
GOOGLE_ADS_API_BASE=https://googleads.googleapis.com/v16
GOOGLE_ADS_TOKEN=your-google-token

INGEST_INTERVAL_MINUTES=5
DIAGNOSE_INTERVAL_MINUTES=10
